NODE_ENV=development
HOST=0.0.0.0
PORT=4173
API_PREFIX=/api/v1

# Comma-separated origins allowed to call the API in development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Contact submissions are stored locally by default.
CONTACT_STORAGE_FILE=storage/contacts.ndjson
CONTACT_RATE_LIMIT_WINDOW_MS=600000
CONTACT_RATE_LIMIT_MAX=5

# Content edited from /admin is stored locally together with uploaded images.
CONTENT_STORAGE_FILE=storage/content.json
CONTENT_MEDIA_DIRECTORY=storage/media

# Set a private password (12+ characters) before exposing /admin publicly.
ADMIN_PASSWORD=replace-with-a-long-private-password
ADMIN_SESSION_HOURS=12

# Production URL used in metadata and future email integrations.
SITE_URL=http://localhost:4173

# When true, the API also serves the built Vite frontend from frontend/dist.
SERVE_FRONTEND=true
